async function loadArchitecture(){
  const data=await api('/api/status');
  const sub=data.services?.sub||[];
  const cb=sub.find(s=>s.service==='ContentBasedService')||{};
  const cf=sub.find(s=>s.service==='CollaborativeFilteringService')||{};
  const kg=sub.find(s=>s.service==='KnowledgeGraphService')||{};
  const hy=data.services||{};
  if(cb.vocab_size)document.getElementById('arch-cb-vocab').textContent=cb.vocab_size.toLocaleString();
  if(cb.papers_indexed)document.getElementById('arch-cb-papers').textContent=cb.papers_indexed;
  if(cf.matrix_shape)document.getElementById('arch-cf-matrix').textContent=cf.matrix_shape;
  if(cf.explained_variance)document.getElementById('arch-cf-var').textContent=cf.explained_variance;
  if(kg.nodes)document.getElementById('arch-kg-nodes').textContent=kg.nodes;
  if(kg.edges)document.getElementById('arch-kg-edges').textContent=kg.edges;
  if(kg.keywords)document.getElementById('arch-kg-kw').textContent=kg.keywords;
  const wr=document.getElementById('weight-rows');wr.innerHTML='';
  const cols={'content_based':'#3b82f6','collaborative':'#16a34a','knowledge_graph':'#d97706'};
  const labels={'content_based':'📄 Content-Based','collaborative':'👥 Collaborative','knowledge_graph':'🔗 Knowledge Graph'};
  const weights=hy.weights||{content_based:.4,collaborative:.35,knowledge_graph:.25};
  Object.entries(weights).forEach(([k,v])=>{
    wr.innerHTML+=`<div class="wt-row"><div class="wt-name">${labels[k]||k}</div><div class="wt-bar"><div class="wt-fill" style="width:${v*100}%;background:${cols[k]||'#94a3b8'}"></div></div><div class="wt-pct">${Math.round(v*100)}%</div></div>`;
  });
  const statsEl=document.getElementById('arch-stats');
  statsEl.innerHTML=`
    <div class="stat-card"><div class="stat-val">${data.papers||200}</div><div class="stat-label">Статей</div></div>
    <div class="stat-card"><div class="stat-val">${data.users||5}</div><div class="stat-label">Профілів</div></div>
    <div class="stat-card"><div class="stat-val" style="color:#2563eb">${cb.vocab_size||'—'}</div><div class="stat-label">TF-IDF токени</div></div>
    <div class="stat-card"><div class="stat-val" style="color:#d97706">${kg.edges||'—'}</div><div class="stat-label">Ребра графу</div></div>
    <div class="stat-card"><div class="stat-val" style="color:#7c3aed">${cf.explained_variance||'—'}</div><div class="stat-label">SVD дисперсія</div></div>
    <div class="stat-card"><div class="stat-val">3</div><div class="stat-label">ML моделі</div></div>`;
}

function loadCompareUsers(){loadUserGrid('compare-user-grid','compareUser');}
document.getElementById('btn-compare').addEventListener('click',async()=>{
  if(!S.compareUser){showFlash('Оберіть профіль','red');return;}
  const el=document.getElementById('compare-results');
  el.innerHTML='<div class="loader"><div class="spinner"></div><div class="loader-text">Запит до всіх моделей…</div></div>';
  const data=await api(`/api/recommend/${S.compareUser}?top_k=8&diversity=0.0`);
  if(data.error){el.innerHTML=`<div class="empty">${data.error}</div>`;return;}
  const byModel={content_based:[],collaborative:[],knowledge_graph:[],hybrid:[]};
  data.recommendations.forEach(rec=>{byModel.hybrid.push(rec);rec.models.forEach(m=>{if(byModel[m])byModel[m].push(rec);});});
  el.innerHTML='';
  const wrap=document.createElement('div');wrap.className='cmp-grid';
  [{key:'content_based',label:'📄 Content-Based',color:'#2563eb'},
   {key:'collaborative', label:'👥 Collaborative', color:'#16a34a'},
   {key:'knowledge_graph',label:'🔗 Knowledge Graph',color:'#d97706'},
   {key:'hybrid',        label:'⚡ Hybrid Ensemble',color:'#7c3aed'}].forEach(col=>{
    const card=document.createElement('div');card.className='cmp-col';
    const items=byModel[col.key].slice(0,5);
    card.innerHTML=
      `<div class="cmp-head"><div class="cmp-head-label" style="color:${col.color}">${col.label}</div><div class="cmp-head-count">${items.length} результатів</div></div>`+
      `<div class="cmp-body">`+
      (items.length===0?'<div style="font-size:11px;color:var(--ink3);padding:6px">Недостатньо взаємодій</div>':
        items.map((r,i)=>
          `<div class="cmp-item"><div class="cmp-num" style="color:${col.color}">${i+1}</div>`+
          `<div><div class="cmp-text">${r.paper.title.substring(0,55)}${r.paper.title.length>55?'…':''}</div>`+
          `<div class="cmp-meta">${r.paper.venue} ${r.paper.year} · ${r.paper.citations} cit.</div></div></div>`).join(''))+
      `</div>`;
    wrap.appendChild(card);
  });
  el.appendChild(wrap);
});

async function loadUserState(uid){
  if(!uid){S.userState={viewed:[],liked:[],saved:[]};updateLikedBadge();return;}
  try{
    const data=await api('/api/users/'+uid+'/history');
    S.userState.viewed=(data.viewed||[]).map(p=>p.id);
    S.userState.liked=(data.liked||[]).map(p=>p.id);
    S.userState.saved=(data.saved||[]).map(p=>p.id);
    updateLikedBadge();
  }catch(e){}
}
function updateLikedBadge(){const el=document.getElementById('badge-liked');if(el)el.textContent=S.userState.liked.length;}
async function doInteract(paperId,action,cardDiv){
  if(!S.user)return;
  const r=await fetch('/api/interact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({user_id:S.user,paper_id:paperId,action})});
  const data=await r.json();
  if(!data.ok)return;
  S.userState.viewed=data.viewed;S.userState.liked=data.liked;S.userState.saved=data.saved;
  if(cardDiv)refreshCardState(cardDiv,S.userState);
  document.querySelectorAll('.paper-card[data-paper-id="'+paperId+'"]').forEach(d=>{if(d!==cardDiv)refreshCardState(d,S.userState);});
  updateLikedBadge();
}
function refreshCardState(div,state){
  const pid=div.dataset.paperId;if(!pid)return;
  const isV=state.viewed.includes(pid);
  const isL=state.liked.includes(pid);
  const iS=state.saved.includes(pid);
  const bV=div.querySelector('.btn-view');const bL=div.querySelector('.btn-like');const bS=div.querySelector('.btn-save');
  const meta=div.querySelector('.paper-meta');
  if(bV){bV.classList.toggle('saved',isV);bV.textContent=isV?'✓ Прочитано':'👁 Прочитано';}
  if(bL){bL.classList.toggle('liked',isL);bL.textContent=isL?'♥ Лайкнуто':'♥ Лайк';}
  if(bS){bS.classList.toggle('saved',iS);bS.textContent=iS?'🔖 Збережено':'🔖 Зберегти';}
  if(meta){
    const ex=meta.querySelector('.viewed-chip');
    if(isV&&!ex){const chip=document.createElement('span');chip.className='meta-chip viewed-chip';chip.textContent='✓ Прочитано';meta.appendChild(chip);}
    else if(!isV&&ex)ex.remove();
  }
}

function makePaperCard(rec,showScore){
  const p=rec.paper;
  const div=document.createElement('div');
  div.className='paper-card';div.dataset.paperId=p.id;
  const authExtra=p.authors.length>3?' +'+(p.authors.length-3):'';
  const mbCls={'content_based':'mb-cb','collaborative':'mb-cf','knowledge_graph':'mb-kg'};
  const mbLbl={'content_based':'CB','collaborative':'CF','knowledge_graph':'KG'};
  const modelBadges=(rec.models||[]).map(m=>`<span class="model-badge ${mbCls[m]||''}">${mbLbl[m]||m}</span>`).join('');
  const isV=S.userState.viewed.includes(p.id);
  const isL=S.userState.liked.includes(p.id);
  const iS=S.userState.saved.includes(p.id);
  const scoreBar=showScore&&rec.score>0?
    `<div class="paper-score"><span class="score-label">score</span><div class="score-bar-wrap"><div class="score-bar-fill" style="width:${rec.score*100}%"></div></div><span class="score-val">${rec.score.toFixed(3)}</span></div>`:'';
  const reasons=(rec.reasons||[]).slice(0,1).map(r=>`<div class="paper-reason">${r}</div>`).join('');
  div.innerHTML=
    `<div class="paper-header"><div class="paper-rank-badge">${rec.rank||'·'}</div><div class="paper-title">${p.title}</div></div>`+
    `<div style="font-size:11px;color:var(--ink3);margin-bottom:7px;font-family:var(--font-mono)">${p.authors.slice(0,3).map(a=>a.name).join(', ')}${authExtra}</div>`+
    `<div class="paper-meta">`+
      `<span class="meta-chip chip-venue">${p.venue}</span>`+
      `<span class="meta-chip chip-year">${p.year}</span>`+
      (p.open_access?'<span class="meta-chip chip-oa">Open Access</span>':'')+
      `<span class="meta-chip chip-cite">⭑ ${p.citations}</span>`+
      (isV?'<span class="meta-chip viewed-chip">✓ Прочитано</span>':'')+
    `</div>`+scoreBar+
    `<div class="paper-keywords">${p.keywords.map(k=>`<span class="tag">${k}</span>`).join('')}</div>`+
    (modelBadges?`<div class="paper-models">${modelBadges}</div>`:'')+reasons+
    `<div class="paper-abstract">${p.abstract}</div>`+
    `<div class="action-bar">`+
      (p.doi?`<a href="https://doi.org/${p.doi}" target="_blank" class="act-btn">DOI ↗</a>`:'')+
      `<button class="act-btn btn-similar">◎ Схожі</button>`+
      (S.user?
        `<button class="act-btn btn-view${isV?' saved':''}">${isV?'✓ Прочитано':'👁 Прочитано'}</button>`+
        `<button class="act-btn btn-like${isL?' liked':''}">${isL?'♥ Лайкнуто':'♥ Лайк'}</button>`+
        `<button class="act-btn btn-save${iS?' saved':''}">${iS?'🔖 Збережено':'🔖 Зберегти'}</button>`:'')+
    `</div>`;
  div.querySelector('.paper-title').addEventListener('click',()=>div.classList.toggle('expanded'));
  div.querySelector('.btn-similar').addEventListener('click',()=>loadSimilar(p.id,p.title.substring(0,40)));
  if(S.user){
    div.querySelector('.btn-view').addEventListener('click',function(){if(!this.classList.contains('saved'))doInteract(p.id,'view',div);});
    div.querySelector('.btn-like').addEventListener('click',function(){doInteract(p.id,this.classList.contains('liked')?'unlike':'like',div);});
    div.querySelector('.btn-save').addEventListener('click',function(){doInteract(p.id,this.classList.contains('saved')?'unsave':'save',div);});
  }
  return div;
}

async function loadSimilar(pid,titleShort){
  const overlay=document.createElement('div');
  overlay.className='sim-overlay';
  overlay.innerHTML=
    `<div class="sim-box">`+
      `<div class="sim-head">`+
        `<div><div style="font-family:var(--font-head);font-size:16px;font-weight:500">Схожі статті</div><div style="font-size:11px;color:var(--ink3);font-family:var(--font-mono);margin-top:1px">${titleShort}…</div></div>`+
        `<button id="btn-close-sim" class="modal-close">×</button>`+
      `</div>`+
      `<div class="sim-body" id="sim-body"><div class="loader"><div class="spinner"></div><div class="loader-text">Пошук схожих…</div></div></div>`+
    `</div>`;
  overlay.addEventListener('click',e=>{if(e.target===overlay)overlay.remove();});
  document.body.appendChild(overlay);
  document.getElementById('btn-close-sim').addEventListener('click',()=>overlay.remove());
  try{
    const data=await api('/api/similar/'+pid);
    const body=document.getElementById('sim-body');body.innerHTML='';
    if(!data.length){body.innerHTML='<div class="empty"><div class="empty-icon">◎</div><div>Схожих не знайдено</div></div>';return;}
    const list=document.createElement('div');list.className='papers-list';
    data.forEach((r,i)=>list.appendChild(makePaperCard({rank:i+1,score:r.score,models:[],reasons:['📄 Content similarity'],paper:r.paper},true)));
    body.appendChild(list);
  }catch(e){document.getElementById('sim-body').innerHTML='<div class="empty"><div>Помилка</div></div>';}
}

document.getElementById('user-grid').addEventListener('click',async e=>{
  const card=e.target.closest('.user-card');
  if(card&&card.dataset.uid)await loadUserState(card.dataset.uid);
});

loadStatus();
</script>
</body>
