class RecommendationSystem:
    def __init__(self):
        logger.info("Initializing Recommendation System...")
        self.papers=generate_dataset(200)
        self.users=load_users()
        self.users_map={u.user_id:u for u in self.users}
        self._simulate()
        self.cb=ContentBasedService(); self.cf=CollaborativeFilteringService(15); self.kg=KnowledgeGraphService()
        self.cb.fit(self.papers); self.cf.fit(self.users,self.papers); self.kg.fit(self.papers)
        self.hybrid=HybridService(self.cb,self.cf,self.kg)
        logger.info("✓ System ready!")
    def _simulate(self):
        rng=random.Random(99); dm={}
        for p in self.papers:
            for kw in p.keywords: dm.setdefault(kw.lower(),[]).append(p)
        for u in self.users:
            rel=list({p.id:p for i in u.research_interests for kw,ps in dm.items() for p in ps if any(w in kw for w in i.lower().split())}.values())
            if not rel: rel=rng.sample(self.papers,15)
            s=rng.sample(rel,min(12,len(rel)))
            for p in s[:8]: u.add_interaction(p.id,"view")
            for p in s[2:6]: u.add_interaction(p.id,"like")
            for p in s[4:7]: u.add_interaction(p.id,"save")

