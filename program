def _author(rng,aid): return Author(f"A{aid:04d}",f"{rng.choice(_FN)} {rng.choice(_LN)}",rng.choice(_INST),rng.randint(2,45))
def _paper(rng,pid,domain):
    d=DOMAINS[domain]; topic=rng.choice(d["topics"]); kws=rng.sample(d["keywords"],k=rng.randint(3,6)); year=rng.randint(2018,2024)
    titles=[f"{topic} via {kws[0].title()} and {kws[1].title()}",
            f"Towards Efficient {topic}: A {kws[0].title()}-Based Approach",
            f"Rethinking {kws[0].title()} for {topic}",
            f"A Unified Framework for {topic} with {kws[1].title()}",
            f"Scalable {topic} Using {kws[0].title()}",
            f"Self-Supervised {topic} with {kws[1].title()} Pretraining"]
    abs_=[f"We present a novel approach to {topic.lower()} leveraging {kws[0]} techniques. Our method integrates {kws[1]} with {kws[2]} to address key challenges in the field. Extensive experiments on benchmark datasets demonstrate state-of-the-art performance, outperforming existing methods by a significant margin. We further analyze the theoretical properties of our approach and provide convergence guarantees under mild assumptions.",
          f"This paper introduces a new paradigm for {topic.lower()} based on {kws[0]}. Unlike prior work that relies on {kws[1]}, our framework directly optimizes the end-to-end objective using {kws[2]}. We validate our approach on multiple real-world datasets and show significant improvements in both accuracy and computational efficiency. Code and pretrained models are released publicly.",
          f"Recent advances in {kws[0]} have shown promising results for {topic.lower()}. However, existing approaches suffer from scalability issues in large-scale settings. We propose a novel {kws[1]}-based method that overcomes these limitations. Our key insight is that {kws[2]} can significantly reduce computational overhead while maintaining high accuracy."]
    return Paper(f"P{pid:05d}",rng.choice(titles),rng.choice(abs_),
                 [_author(rng,pid*10+i) for i in range(rng.randint(2,5))],
                 kws+[domain.replace("_"," ")],year,rng.choice(d["venues"]),rng.randint(0,1200),
                 f"10.{rng.randint(1000,9999)}/{domain[:3]}.{year}.{pid:05d}",rng.random()>0.4)

def generate_dataset(n=200):
    rng=random.Random(42); domains=list(DOMAINS.keys()); papers=[]; pid=1
    for domain in domains:
        for _ in range(n//len(domains)): papers.append(_paper(rng,pid,domain)); pid+=1
    while len(papers)<n: papers.append(_paper(rng,pid,rng.choice(domains))); pid+=1
    rng.shuffle(papers); return papers

