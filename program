@app.route("/api/users", methods=["GET","POST"])
def api_users():
    if request.method == "POST":
        d = request.json or {}
        name        = (d.get("name") or "").strip()
        institution = (d.get("institution") or "").strip()
        interests   = [i.strip() for i in d.get("interests", []) if i.strip()]
        if not name:
            return jsonify({"error": "Iм\'я обов\'язкове"}), 400
        if not interests:
            return jsonify({"error": "Вкажiть хоча б один iнтерес"}), 400
        nums = []
        for u in SYS.users:
            if u.user_id.startswith("U"):
                try: nums.append(int(u.user_id[1:]))
                except: pass
        uid = f"U{max(nums, default=0)+1:03d}"
        user = UserProfile(uid, name, interests, institution or "Не вказано")
        SYS.users.append(user)
        SYS.users_map[uid] = user
        try: SYS.cf.fit(SYS.users, SYS.papers)
        except Exception as e: logger.warning(f"CF refit: {e}")
        save_users(SYS.users)
        logger.info(f"New user: {uid} — {name}")
        return jsonify({"ok": True, "user": user.to_dict()}), 201
    return jsonify([u.to_dict() for u in SYS.users])

@app.route("/api/users/<uid>", methods=["PATCH","DELETE"])
def api_user_edit(uid):
    user = SYS.users_map.get(uid)
    if not user:
        return jsonify({"error": "Користувача не знайдено"}), 404

    if request.method == "DELETE":
        SYS.users = [u for u in SYS.users if u.user_id != uid]
        del SYS.users_map[uid]
        save_users(SYS.users)
        try: SYS.cf.fit(SYS.users, SYS.papers)
        except Exception as e: logger.warning(f"CF refit: {e}")
        logger.info(f"Deleted user: {uid}")
        return jsonify({"ok": True})

    # PATCH - edit
    d = request.json or {}
    if "name" in d:
        name = d["name"].strip()
        if not name:
            return jsonify({"error": "Ім'я не може бути порожнім"}), 400
        user.name = name
    if "institution" in d:
        user.institution = d["institution"].strip() or "Не вказано"
    if "interests" in d:
        interests = [i.strip() for i in d["interests"] if i.strip()]
        if not interests:
            return jsonify({"error": "Вкажіть хоча б один інтерес"}), 400
        user.research_interests = interests
    save_users(SYS.users)
    try: SYS.cf.fit(SYS.users, SYS.papers)
    except Exception as e: logger.warning(f"CF refit: {e}")
    logger.info(f"Updated user: {uid}")
    return jsonify({"ok": True, "user": user.to_dict()})

@app.route("/api/recommend/<uid>")
def api_recommend(uid):
    top_k=int(request.args.get("top_k",10))
    lam=float(request.args.get("diversity",0.3))
    user=SYS.users_map.get(uid)
    if not user: return jsonify({"error":"User not found"}),404
    result=SYS.hybrid.recommend(user,SYS.papers,top_k=top_k,lam=lam)
