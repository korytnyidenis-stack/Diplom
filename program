<script>
const S={page:'recommend',user:null,compareUser:null,browsePage:1,users:[],userState:{viewed:[],liked:[],saved:[]}};
const PAGES={recommend:'Рекомендації',catalog:'Статті',mypapers:'Мої статті',users:'Профілі',architecture:'Архітектура',compare:'Порівняння ML'};

document.querySelectorAll('.nav-item').forEach(el=>{
  el.addEventListener('click',()=>{
    const pg=el.dataset.page;
    document.querySelectorAll('.nav-item').forEach(e=>e.classList.remove('active'));
    el.classList.add('active');
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    document.getElementById('page-'+pg).classList.add('active');
    document.getElementById('topbar-title').textContent=PAGES[pg]||pg;
    document.getElementById('topbar-page').textContent=pg;
    S.page=pg;
    if(pg==='architecture')loadArchitecture();
    if(pg==='catalog')loadBrowse();
    if(pg==='users')loadUsers();
    if(pg==='compare')loadCompareUsers();
    if(pg==='mypapers')loadMyPapers();
  });
});

const api=url=>fetch(url).then(r=>r.json());
const showFlash=(msg,type='green')=>{
  const f=document.createElement('div');
  f.className=`flash ${type}`;
  f.textContent=(type==='green'?'✓ ':type==='red'?'✕ ':'◈ ')+msg;
  document.body.appendChild(f);
  setTimeout(()=>f.remove(),3000);
};

async function loadStatus(){
  try{
    await api('/api/status');
    ['cb','cf','kg','hybrid'].forEach(d=>{const dot=document.getElementById('dot-'+d);if(dot)dot.style.background='var(--green)';});
  }catch(e){}
}

async function loadUserGrid(containerId,stateKey){
  const users=await api('/api/users');
  S.users=users;
  const grid=document.getElementById(containerId);
  grid.innerHTML='';
  users.forEach(u=>{
    const div=document.createElement('div');
    div.className='user-card'+(S[stateKey]===u.user_id?' selected':'');
    div.dataset.uid=u.user_id;
    div.innerHTML=
      `<div class="user-name">${u.name}</div>`+
      `<div class="user-inst">${u.user_id} · ${u.institution.split(' ').slice(0,3).join(' ')}</div>`+
      `<div style="display:flex;flex-wrap:wrap;gap:3px;margin-bottom:7px">${u.research_interests.slice(0,3).map(i=>`<span class="tag">${i}</span>`).join('')}</div>`+
      `<div style="font-size:10px;color:var(--ink3);font-family:var(--font-mono)">👁 ${u.viewed} · ♥ ${u.liked} · 🔖 ${u.saved}</div>`;
    div.addEventListener('click',async()=>{
      S[stateKey]=u.user_id;
      document.querySelectorAll('#'+containerId+' .user-card').forEach(c=>c.classList.remove('selected'));
      div.classList.add('selected');
      if(stateKey==='user')await loadUserState(u.user_id);
    });
    grid.appendChild(div);
  });
}

loadUserGrid('user-grid','user');
document.getElementById('diversity-slider').addEventListener('input',function(){document.getElementById('div-val').textContent=this.value;});
document.getElementById('btn-recommend').addEventListener('click',async()=>{
  if(!S.user){showFlash('Оберіть профіль','red');return;}
  const topK=document.getElementById('top-k').value;
  const div=document.getElementById('diversity-slider').value;
  const res=document.getElementById('rec-results');
  const meta=document.getElementById('rec-meta');
  res.innerHTML='<div class="loader"><div class="spinner"></div><div class="loader-text">Запит до мікросервісів…</div></div>';
  meta.style.display='none';
  const data=await api(`/api/recommend/${S.user}?top_k=${topK}&diversity=${div}`);
  if(data.error){res.innerHTML=`<div class="empty"><div class="empty-icon">⚠</div>${data.error}</div>`;return;}
  const m=data.metadata;
  document.getElementById('m-total').textContent=m.total;
  document.getElementById('m-cb').textContent=m.cb;
  document.getElementById('m-cf').textContent=m.cf;
  document.getElementById('m-kg').textContent=m.kg;
  document.getElementById('m-lat').textContent=m.latency_ms;
  document.getElementById('m-lam').textContent=m.lambda;
  document.getElementById('topbar-latency').textContent=m.latency_ms+'ms';
  const wviz=document.getElementById('weight-viz');
  const wc={'content_based':'#3b82f6','collaborative':'#16a34a','knowledge_graph':'#d97706'};
  wviz.innerHTML=Object.entries(m.weights).map(([k,v])=>`<div class="weight-seg" style="width:${v*100}%;background:${wc[k]||'#94a3b8'}"></div>`).join('');
  meta.style.display='block';
  res.innerHTML='';
  const list=document.createElement('div');list.className='papers-list';
  data.recommendations.forEach(rec=>list.appendChild(makePaperCard(rec,true)));
  res.appendChild(list);
});

let searchTimer=null;
document.getElementById('search-input').addEventListener('input',function(){
  const q=this.value.trim();
  document.getElementById('btn-clear-search').style.display=q?'block':'none';
  clearTimeout(searchTimer);
  if(!q){
    document.getElementById('search-results').style.display='none';
    document.getElementById('browse-results').style.display='block';
    document.getElementById('catalog-status').innerHTML='';
    return;
  }
  searchTimer=setTimeout(()=>doSearch(q),280);
});
document.getElementById('btn-clear-search').addEventListener('click',()=>{
  document.getElementById('search-input').value='';
  document.getElementById('btn-clear-search').style.display='none';
  document.getElementById('search-results').style.display='none';
  document.getElementById('browse-results').style.display='block';
  document.getElementById('catalog-status').innerHTML='';
});
async function doSearch(q){
  const sr=document.getElementById('search-results');
  const br=document.getElementById('browse-results');
  sr.style.display='block';br.style.display='none';
  sr.innerHTML='<div class="loader"><div class="spinner"></div><div class="loader-text">Пошук…</div></div>';
  const data=await api('/api/search?q='+encodeURIComponent(q));
  document.getElementById('catalog-status').innerHTML=`Знайдено <b style="color:var(--accent)">${data.length}</b> за запитом <b>"${q}"</b>`;
  sr.innerHTML='';
  if(!data.length){sr.innerHTML='<div class="empty"><div class="empty-icon">◎</div><div>Нічого не знайдено</div></div>';return;}
  const list=document.createElement('div');list.className='papers-list';
  data.forEach((r,i)=>list.appendChild(makePaperCard({rank:i+1,score:Math.min(r.relevance/20,1),models:[],reasons:[],paper:r.paper},false)));
  sr.appendChild(list);
}
async function loadBrowse(){
  document.getElementById('search-input').value='';
  document.getElementById('btn-clear-search').style.display='none';
  document.getElementById('search-results').style.display='none';
  document.getElementById('browse-results').style.display='block';
  const br=document.getElementById('browse-results');
  br.innerHTML='<div class="loader"><div class="spinner"></div><div class="loader-text">Завантаження…</div></div>';
  const data=await api('/api/papers?page='+S.browsePage);
  const badge=document.getElementById('badge-catalog');
  if(badge)badge.textContent=data.total;
  document.getElementById('browse-info').textContent=data.page+' / '+data.pages;
  document.getElementById('catalog-status').innerHTML=`Всього <b style="color:var(--accent)">${data.total}</b> статей`;
  const list=document.createElement('div');list.className='papers-list';
  data.papers.forEach((p,i)=>list.appendChild(makePaperCard({rank:(S.browsePage-1)*20+i+1,score:0,models:[],reasons:[],paper:p},false)));
  br.innerHTML='';br.appendChild(list);
  document.getElementById('btn-prev').disabled=S.browsePage<=1;
  document.getElementById('btn-next').disabled=S.browsePage>=data.pages;
}
document.getElementById('btn-prev').addEventListener('click',()=>{if(S.browsePage>1){S.browsePage--;loadBrowse();}});
document.getElementById('btn-next').addEventListener('click',()=>{S.browsePage++;loadBrowse();});

document.getElementById('tag-input').addEventListener('keydown',e=>{if(e.key==='Enter')document.getElementById('btn-find-tag').click();});
document.getElementById('btn-find-tag').addEventListener('click',async()=>{
  const tag=document.getElementById('tag-input').value.trim();
  if(!tag)return;
  const el=document.getElementById('tag-result');
  el.style.display='block';
  el.innerHTML='<div class="loader" style="padding:12px"><div class="spinner"></div></div>';
  const data=await api('/api/papers/tag/'+encodeURIComponent(tag));
  if(!data.papers.length){el.innerHTML=`<div style="font-size:12px;color:var(--ink3)">Статей з тегом <b>"${tag}"</b> не знайдено</div>`;return;}
  el.innerHTML=`<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap">
    <span style="font-size:12px;color:var(--ink)">Знайдено <b style="color:var(--accent)">${data.total}</b> статей з тегом <b>"${tag}"</b></span>
    <button class="btn btn-danger btn-sm" id="btn-confirm-delete">✕ Видалити тег з усіх</button>
  </div><div class="papers-list" id="tag-papers-list"></div>`;
  const list=document.getElementById('tag-papers-list');
  data.papers.slice(0,5).forEach((p,i)=>list.appendChild(makePaperCard({rank:i+1,score:0,models:[],reasons:[],paper:p},false)));
  document.getElementById('btn-confirm-delete').addEventListener('click',async()=>{
    if(!confirm(`Видалити тег "${tag}" з ${data.total} статей?`))return;
    const r=await fetch('/api/papers/tag/'+encodeURIComponent(tag),{method:'DELETE'});
    const res=await r.json();
    el.innerHTML=`<div style="font-size:12px;color:var(--green)">✓ Тег "${tag}" видалено з ${res.papers_affected} статей</div>`;
    document.getElementById('tag-input').value='';
    showFlash(`Тег "${tag}" видалено`,'green');
    loadBrowse();
  });
});
document.getElementById('btn-delete-tag').addEventListener('click',()=>{
  const tag=document.getElementById('tag-input').value.trim();
  if(!tag){document.getElementById('tag-input').focus();return;}
  document.getElementById('btn-find-tag').click();
});

async function loadMyPapers(){
  if(!S.user){
    ['viewed','liked','saved'].forEach(t=>{document.getElementById('mypapers-'+t).innerHTML='<div class="empty"><div class="empty-icon">◈</div><div>Оберіть профіль на сторінці рекомендацій</div></div>';});
    return;
  }
  const user=S.users.find(u=>u.user_id===S.user);
  if(user)document.getElementById('mypapers-user-label').textContent=user.name+' · '+user.institution;
  ['viewed','liked','saved'].forEach(t=>{document.getElementById('mypapers-'+t).innerHTML='<div class="loader"><div class="spinner"></div></div>';});
  const data=await api('/api/users/'+S.user+'/history');
  S.userState.viewed=(data.viewed||[]).map(p=>p.id);
  S.userState.liked=(data.liked||[]).map(p=>p.id);
  S.userState.saved=(data.saved||[]).map(p=>p.id);
  updateLikedBadge();
  document.getElementById('cnt-viewed').textContent=data.viewed.length;
  document.getElementById('cnt-liked').textContent=data.liked.length;
  document.getElementById('cnt-saved').textContent=data.saved.length;
  const renderTab=(tabId,papers)=>{
    const el=document.getElementById('mypapers-'+tabId);
    el.innerHTML='';
    if(!papers.length){el.innerHTML='<div class="empty"><div class="empty-icon">'+(tabId==='viewed'?'👁':tabId==='liked'?'♥':'🔖')+'</div><div>Поки немає статей</div></div>';return;}
    const list=document.createElement('div');list.className='papers-list';
    papers.forEach((p,i)=>list.appendChild(makePaperCard({rank:i+1,score:0,models:[],reasons:[],paper:p},false)));
    el.appendChild(list);
  };
  renderTab('viewed',data.viewed);renderTab('liked',data.liked);renderTab('saved',data.saved);
}
document.querySelectorAll('.tab-btn').forEach(btn=>{
  btn.addEventListener('click',function(){
    document.querySelectorAll('.tab-btn').forEach(b=>b.classList.remove('active'));
    this.classList.add('active');
    const tab=this.dataset.tab;
    document.querySelectorAll('.tab-content').forEach(c=>{c.style.display='none';c.classList.remove('active');});
    const tc=document.getElementById('mypapers-'+tab);tc.style.display='block';tc.classList.add('active');
  });
});

async function loadUsers(){
  const users=await api('/api/users');
  const list=document.getElementById('users-list');
  list.innerHTML='';
  users.forEach(u=>{
    const div=document.createElement('div');
    div.className='user-list-card';
    div.innerHTML=
      `<div class="user-list-head">`+
        `<div><div class="user-list-name">${u.name}</div><div class="user-list-id">${u.user_id} · ${u.institution}</div></div>`+
        `<div class="user-stats"><span>👁 ${u.viewed}</span><span style="color:var(--red)">♥ ${u.liked}</span><span style="color:var(--green)">🔖 ${u.saved}</span></div>`+
      `</div>`+
      `<div style="display:flex;flex-wrap:wrap;gap:4px">${u.research_interests.map(i=>`<span class="tag accent">${i}</span>`).join('')}</div>`+
      `<div class="user-actions">`+
        `<button class="btn btn-soft btn-sm" data-go="${u.user_id}">✦ Рекомендації</button>`+
        `<button class="btn btn-outline btn-sm" data-edit='${JSON.stringify(u)}'>✎ Редагувати</button>`+
        `<button class="btn btn-danger btn-sm" data-del="${u.user_id}" data-name="${u.name}">✕ Видалити</button>`+
      `</div>`;
    div.querySelector('[data-go]').addEventListener('click',()=>selectUserAndGo(u.user_id));
    div.querySelector('[data-edit]').addEventListener('click',function(){openEditModal(JSON.parse(this.dataset.edit));});
    div.querySelector('[data-del]').addEventListener('click',function(){deleteUser(this.dataset.del,this.dataset.name);});
    list.appendChild(div);
  });
}
function selectUserAndGo(uid){
  S.user=uid;
  document.querySelectorAll('.nav-item').forEach(e=>e.classList.remove('active'));
  document.querySelector('[data-page="recommend"]').classList.add('active');
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  document.getElementById('page-recommend').classList.add('active');
  document.getElementById('topbar-title').textContent='Рекомендації';
  document.getElementById('topbar-page').textContent='recommend';
  document.querySelectorAll('#user-grid .user-card').forEach(c=>c.classList.toggle('selected',c.dataset.uid===uid));
  loadUserState(uid);
}

function openEditModal(u){
  document.getElementById('edit-uid').value=u.user_id;
  document.getElementById('edit-name').value=u.name;
  document.getElementById('edit-inst').value=u.institution;
  document.getElementById('edit-interests').value=u.research_interests.join(', ');
  updateEditPreview();
  document.getElementById('edit-error').style.display='none';
  document.getElementById('edit-modal').classList.add('open');
  document.getElementById('edit-name').focus();
}
function closeEditModal(){document.getElementById('edit-modal').classList.remove('open');}
function updateEditPreview(){
  const tags=document.getElementById('edit-interests').value.split(',').map(s=>s.trim()).filter(Boolean);
  document.getElementById('edit-interests-preview').innerHTML=tags.map(t=>`<span class="tag accent">${t}</span>`).join('');
}
document.getElementById('edit-interests').addEventListener('input',updateEditPreview);
document.getElementById('btn-close-edit').addEventListener('click',closeEditModal);
document.getElementById('btn-close-edit2').addEventListener('click',closeEditModal);
document.getElementById('edit-modal').addEventListener('click',e=>{if(e.target===document.getElementById('edit-modal'))closeEditModal();});
document.getElementById('btn-save-edit').addEventListener('click',async()=>{
  const uid=document.getElementById('edit-uid').value;
  const name=document.getElementById('edit-name').value.trim();
  const inst=document.getElementById('edit-inst').value.trim();
  const interests=document.getElementById('edit-interests').value.split(',').map(s=>s.trim()).filter(Boolean);
  const errEl=document.getElementById('edit-error');
  errEl.style.display='none';
  if(!name){errEl.textContent="Введіть ім'я";errEl.style.display='inline';return;}
  if(!interests.length){errEl.textContent='Вкажіть хоча б один інтерес';errEl.style.display='inline';return;}
  const btn=document.getElementById('btn-save-edit');btn.textContent='...';btn.disabled=true;
  try{
    const r=await fetch('/api/users/'+uid,{method:'PATCH',headers:{'Content-Type':'application/json'},body:JSON.stringify({name,institution:inst,interests})});
    const data=await r.json();
    if(!r.ok){errEl.textContent=data.error||'Помилка';errEl.style.display='inline';return;}
    closeEditModal();loadUsers();
    loadUserGrid('user-grid','user');loadUserGrid('compare-user-grid','compareUser');
    showFlash('Профіль '+data.user.name+' оновлено','green');
  }catch(e){errEl.textContent='Помилка';errEl.style.display='inline';}
  finally{btn.textContent='Зберегти зміни';btn.disabled=false;}
});
async function deleteUser(uid,name){
  if(!confirm(`Видалити профіль "${name}"?`))return;
  const r=await fetch('/api/users/'+uid,{method:'DELETE'});
