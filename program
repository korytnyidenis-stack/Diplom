  border: 1px solid var(--accent-br);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--font-mono); font-size: 10px; font-weight: 500; color: var(--accent);
}
.paper-header { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 7px; }
.paper-title {
  font-family: var(--font-head); font-size: 15px; font-weight: 500;
  color: var(--ink); line-height: 1.35; flex: 1; cursor: pointer;
}
.paper-title:hover { color: var(--accent); }
.paper-meta { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; margin-bottom: 9px; }
.meta-chip {
  font-size: 10px; font-family: var(--font-mono);
  padding: 2px 8px; border-radius: 20px; border: 1px solid;
}
.chip-venue  { background: var(--violet-bg); border-color: var(--violet-br); color: var(--violet); }
.chip-year   { background: var(--amber-bg);  border-color: var(--amber-br);  color: var(--amber);  }
.chip-oa     { background: var(--green-bg);  border-color: var(--green-br);  color: var(--green);  }
.chip-cite   { background: var(--bg3); border-color: var(--border); color: var(--ink3); }
.viewed-chip { background: var(--accent-bg); border-color: var(--accent-br); color: var(--accent); }
.paper-score { display: flex; align-items: center; gap: 8px; margin-bottom: 9px; }
.score-label { font-size: 9px; color: var(--ink3); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }
.score-bar-wrap { flex: 1; max-width: 130px; height: 4px; background: var(--bg3); border-radius: 3px; overflow: hidden; }
.score-bar-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg,#3b82f6,#2563eb); transition: width .5s ease; }
.score-val { font-size: 10px; color: var(--accent); font-family: var(--font-mono); font-weight: 500; min-width: 36px; }
.paper-keywords { display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 8px; }
.paper-abstract {
  font-size: 12.5px; color: var(--ink2); line-height: 1.65;
  display: none; margin-top: 10px; padding-top: 10px;
  border-top: 1px solid var(--border);
}
.paper-card.expanded .paper-abstract { display: block; }
.paper-models { display: flex; gap: 4px; flex-wrap: wrap; margin-bottom: 6px; }
.model-badge { font-size: 9px; font-family: var(--font-mono); padding: 2px 7px; border-radius: 20px; font-weight: 500; }
.mb-cb { background: #eff6ff; border: 1px solid #bfdbfe; color: #1d4ed8; }
.mb-cf { background: #f0fdf4; border: 1px solid #bbf7d0; color: #15803d; }
.mb-kg { background: #fffbeb; border: 1px solid #fde68a; color: #b45309; }
.paper-reason { font-size: 11px; color: var(--ink3); font-style: italic; margin-top: 4px; }

/* ── Action buttons on cards ─────────────────────────────────────── */
.action-bar {
  display: flex; gap: 5px; flex-wrap: wrap;
  margin-top: 10px; padding-top: 10px;
  border-top: 1px solid var(--border);
}
.act-btn {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 10px; border-radius: 20px;
  font-size: 11px; font-family: var(--font-mono); font-weight: 500;
  cursor: pointer; transition: all .12s;
  border: 1.5px solid var(--border);
  background: var(--bg3); color: var(--ink2);
}
.act-btn:hover { background: var(--surface2); color: var(--ink); border-color: var(--border2); }
.act-btn.liked { background: var(--red-bg); border-color: var(--red-br); color: var(--red); }
.act-btn.saved { background: var(--green-bg); border-color: var(--green-br); color: var(--green); }

/* ── Meta bar ────────────────────────────────────────────────────── */
.meta-bar {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r2); padding: 12px 16px;
  margin-bottom: 18px; box-shadow: var(--shadow-sm);
}
.meta-row { display: flex; gap: 18px; flex-wrap: wrap; font-family: var(--font-mono); font-size: 11px; align-items: center; }
.meta-item { color: var(--ink3); }
.meta-item b { color: var(--ink); font-weight: 600; }
.weight-viz { display: flex; align-items: center; gap: 3px; margin-top: 8px; height: 6px; border-radius: 3px; overflow: hidden; width: 180px; }
.weight-seg { height: 100%; transition: width .3s; }

/* ── Stats ───────────────────────────────────────────────────────── */
.stats-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(120px,1fr)); gap: 10px; margin-bottom: 20px; }
.stat-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r2); padding: 14px 16px;
  box-shadow: var(--shadow-sm);
}
.stat-val { font-family: var(--font-head); font-size: 28px; font-weight: 600; color: var(--accent); }
.stat-label { font-size: 10px; color: var(--ink3); margin-top: 2px; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: .06em; }

/* ── Architecture ────────────────────────────────────────────────── */
.arch-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; margin-bottom: 14px; }
.arch-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r2); padding: 16px; position: relative;
  overflow: hidden; box-shadow: var(--shadow-sm);
}
.arch-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; }
.arch-card.cb::before   { background: #3b82f6; }
.arch-card.cf::before   { background: #16a34a; }
.arch-card.kg::before   { background: #d97706; }
.arch-card.hybrid::before { background: linear-gradient(90deg,#7c3aed,#2563eb); }
.arch-title { font-family: var(--font-head); font-size: 14px; font-weight: 500; margin-bottom: 2px; color: var(--ink); }
.arch-model { font-size: 10px; color: var(--accent); font-family: var(--font-mono); margin-bottom: 10px; }
.arch-detail { font-size: 11px; color: var(--ink3); line-height: 1.7; }
.arch-detail span { color: var(--ink2); }

/* ── Flow ────────────────────────────────────────────────────────── */
.flow { display: flex; align-items: center; gap: 0; margin: 16px 0; overflow-x: auto; padding: 4px 0; }
.flow-node {
  flex-shrink: 0; background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r); padding: 6px 12px;
  font-size: 10px; font-family: var(--font-mono); color: var(--ink2);
  white-space: nowrap; box-shadow: var(--shadow-sm);
}
.flow-node.hl { background: var(--accent-bg); border-color: var(--accent-br); color: var(--accent); font-weight: 500; }
.flow-arrow { flex-shrink: 0; color: var(--ink4); padding: 0 5px; font-size: 12px; }

/* ── Weight rows ─────────────────────────────────────────────────── */
.wt-row {
  display: flex; align-items: center; gap: 10px; margin-bottom: 8px;
  padding: 10px 14px; background: var(--bg3);
  border-radius: var(--r); border: 1px solid var(--border);
}
.wt-name { font-size: 11px; font-family: var(--font-mono); color: var(--ink2); width: 130px; flex-shrink: 0; }
.wt-bar { flex: 1; height: 6px; background: var(--border); border-radius: 3px; overflow: hidden; }
.wt-fill { height: 100%; border-radius: 3px; transition: width .3s; }
.wt-pct { font-size: 11px; font-family: var(--font-mono); color: var(--ink); font-weight: 600; min-width: 32px; text-align: right; }

/* ── Tabs ────────────────────────────────────────────────────────── */
.tabs {
  display: flex; gap: 2px; margin-bottom: 18px;
  background: var(--bg3); padding: 3px;
  border-radius: var(--r2); border: 1px solid var(--border);
  width: fit-content;
}
.tab-btn {
  background: transparent; border: none; color: var(--ink3);
  padding: 6px 14px; border-radius: var(--r);
  cursor: pointer; font-size: 12px; font-family: var(--font-body);
  font-weight: 500; transition: all .12s; white-space: nowrap;
}
.tab-btn:hover { color: var(--ink); background: var(--surface); }
.tab-btn.active {
  background: var(--surface); color: var(--accent);
  box-shadow: var(--shadow-sm); border: 1px solid var(--border);
}
.tab-content { display: none; }
.tab-content.active { display: block; }

/* ── Form ────────────────────────────────────────────────────────── */
.form-card {
  background: var(--surface); border: 1.5px solid var(--accent-br);
  border-radius: var(--r3); padding: 22px;
  margin-bottom: 20px; box-shadow: var(--shadow);
}
.form-card-title { font-family: var(--font-head); font-size: 17px; font-weight: 500; margin-bottom: 18px; color: var(--ink); }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px; }
.form-field { display: flex; flex-direction: column; }
.interests-preview { margin-top: 7px; display: flex; flex-wrap: wrap; gap: 4px; min-height: 20px; }
.form-actions { display: flex; gap: 8px; align-items: center; margin-top: 4px; }
.form-error { font-size: 11px; color: var(--red); font-family: var(--font-mono); display: none; }

/* ── Modal ───────────────────────────────────────────────────────── */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,.4);
  z-index: 1000; display: none; align-items: center; justify-content: center;
  backdrop-filter: blur(3px);
}
.modal-overlay.open { display: flex; }
.modal-box {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r3); width: min(500px,94vw);
  overflow: hidden; box-shadow: var(--shadow-lg);
}
.modal-head {
  padding: 18px 22px; border-bottom: 1px solid var(--border);
  display: flex; align-items: center; justify-content: space-between;
  background: var(--bg2);
}
.modal-title { font-family: var(--font-head); font-size: 17px; font-weight: 500; color: var(--ink); }
.modal-close {
  background: var(--bg3); border: 1px solid var(--border);
  color: var(--ink3); font-size: 16px; cursor: pointer;
  padding: 4px 8px; border-radius: var(--r); line-height: 1;
  transition: all .1s;
}
.modal-close:hover { background: var(--border); color: var(--ink); }
.modal-body { padding: 22px; }

/* ── Loader / Empty ──────────────────────────────────────────────── */
.empty { text-align: center; padding: 50px; color: var(--ink3); }
.empty-icon { font-size: 32px; margin-bottom: 10px; opacity: .5; }
.loader { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 50px; gap: 14px; }
.spinner { width: 26px; height: 26px; border: 2.5px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin .65s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.loader-text { font-family: var(--font-mono); font-size: 11px; color: var(--ink3); }

/* ── Catalog toolbar ─────────────────────────────────────────────── */
.catalog-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; flex-wrap: wrap; gap: 10px; }
.catalog-info { font-size: 12px; color: var(--ink3); font-family: var(--font-mono); }
.catalog-info b { color: var(--ink); }
.toolbar-right { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.tag-strip { display: flex; align-items: center; gap: 5px; }
.pager { display: flex; align-items: center; gap: 4px; }
.pager-info { font-size: 11px; color: var(--ink3); font-family: var(--font-mono); padding: 0 5px; }

/* ── User list ───────────────────────────────────────────────────── */
.user-list-card {
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--r2); padding: 16px 18px;
  margin-bottom: 8px; box-shadow: var(--shadow-sm);
  transition: box-shadow .12s;
}
.user-list-card:hover { box-shadow: var(--shadow); }
.user-list-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-bottom: 9px; }
.user-list-name { font-family: var(--font-head); font-size: 16px; font-weight: 500; color: var(--ink); }
.user-list-id { font-size: 10px; color: var(--ink3); font-family: var(--font-mono); margin-top: 1px; }
.user-stats { display: flex; gap: 12px; font-size: 11px; font-family: var(--font-mono); color: var(--ink3); align-items: center; }
.user-actions { display: flex; gap: 6px; margin-top: 10px; flex-wrap: wrap; }

/* ── Compare ─────────────────────────────────────────────────────── */
.cmp-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(240px,1fr)); gap: 12px; }
.cmp-col { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r2); overflow: hidden; box-shadow: var(--shadow-sm); }
.cmp-head { padding: 10px 14px; border-bottom: 1px solid var(--border); background: var(--bg2); }
.cmp-head-label { font-size: 12px; font-weight: 500; }
.cmp-head-count { font-size: 10px; color: var(--ink3); margin-top: 1px; font-family: var(--font-mono); }
.cmp-body { padding: 10px; }
.cmp-item { margin-bottom: 8px; padding-bottom: 8px; border-bottom: 1px solid var(--border); display: flex; gap: 8px; align-items: flex-start; }
.cmp-num { flex-shrink: 0; width: 20px; height: 20px; border-radius: 5px; background: var(--bg3); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 9px; font-family: var(--font-mono); font-weight: 600; color: var(--ink3); }
.cmp-text { font-size: 12px; color: var(--ink); line-height: 1.35; }
.cmp-meta { font-size: 10px; color: var(--ink3); font-family: var(--font-mono); margin-top: 2px; }

/* ── Similar modal ───────────────────────────────────────────────── */
.sim-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 1000; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(3px); }
.sim-box { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r3); width: min(680px,96vw); max-height: 82vh; overflow: hidden; display: flex; flex-direction: column; box-shadow: var(--shadow-lg); }
.sim-head { padding: 16px 22px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; background: var(--bg2); }
.sim-body { overflow-y: auto; padding: 16px 22px; }

/* ── Flash ───────────────────────────────────────────────────────── */
.flash { position: fixed; bottom: 22px; right: 22px; border: 1px solid; border-radius: var(--r2); padding: 11px 16px; font-size: 12px; font-family: var(--font-body); font-weight: 500; z-index: 9999; animation: slideUp .2s ease; max-width: 340px; box-shadow: var(--shadow-lg); }
.flash.green { background: var(--green-bg); border-color: var(--green-br); color: var(--green); }
.flash.red   { background: var(--red-bg);   border-color: var(--red-br);   color: var(--red);   }
.flash.blue  { background: var(--accent-bg); border-color: var(--accent-br); color: var(--accent); }
@keyframes slideUp { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

/* ── Tag result ──────────────────────────────────────────────────── */
#tag-result { padding: 12px 14px; background: var(--surface); border: 1px solid var(--border); border-radius: var(--r2); box-shadow: var(--shadow-sm); }

/* ── My papers header ────────────────────────────────────────────── */
.my-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px; flex-wrap: wrap; gap: 10px; }

/* ── Responsive ──────────────────────────────────────────────────── */
@media(max-width:768px) {
  .layout { grid-template-columns: 1fr; }
  .sidebar { height: auto; position: relative; }
  .arch-grid { grid-template-columns: 1fr; }
  .form-grid { grid-template-columns: 1fr; }
}
</style>
</head>
<body>
<div class="layout">

<!-- ── SIDEBAR ──────────────────────────────────────────────────── -->
<!-- ── MAIN ─────────────────────────────────────────────────────── -->
<main class="main">
  <div class="topbar">
    <div>
      <div class="topbar-bread">SciRec / <span id="topbar-page">recommend</span></div>
      <div class="topbar-title" id="topbar-title">Рекомендації</div>
    </div>
    <div class="topbar-actions">
      <span id="topbar-latency" style="font-size:11px;color:var(--ink3);font-family:var(--font-mono)"></span>
    </div>
  </div>

  <div class="content" id="content">

    <!-- RECOMMEND -->
    <div class="page active" id="page-recommend">
      <div class="alert">
        <span class="alert-icon">✦</span>
        <span>Оберіть профіль дослідника та налаштуйте параметри — система об'єднає три ML-моделі через гібридний ансамбль</span>
      </div>
      <div class="section-hd"><div class="section-title">Профіль дослідника</div></div>
      <div class="user-grid" id="user-grid"></div>
      <div class="controls">
        <div class="ctrl-group">
          <span class="ctrl-label">Топ-K</span>
          <select class="select" id="top-k">
            <option value="5">5</option><option value="10" selected>10</option>
            <option value="15">15</option><option value="20">20</option>
          </select>
        </div>
        <div class="ctrl-group">
          <span class="ctrl-label">Різноманітність λ</span>
          <div class="slider-wrap">
            <span style="font-size:9px;color:var(--ink4);font-family:var(--font-mono)">rel.</span>
            <input type="range" class="slider" id="diversity-slider" min="0" max="1" step="0.05" value="0.3">
            <span style="font-size:9px;color:var(--ink4);font-family:var(--font-mono)">div.</span>
          </div>
          <span id="div-val" style="font-size:11px;color:var(--accent);font-family:var(--font-mono);font-weight:600;min-width:24px">0.3</span>
        </div>
        <button class="btn btn-solid btn-md" id="btn-recommend">✦ Отримати рекомендації</button>
      </div>
      <div id="rec-meta" style="display:none" class="meta-bar">
        <div class="meta-row">
          <span class="meta-item">Кандидати <b id="m-total">—</b></span>
          <span class="meta-item">CB <b id="m-cb" style="color:#1d4ed8">—</b></span>
          <span class="meta-item">CF <b id="m-cf" style="color:#15803d">—</b></span>
          <span class="meta-item">KG <b id="m-kg" style="color:#b45309">—</b></span>
          <span class="meta-item">Латентність <b id="m-lat">—</b> мс</span>
          <span class="meta-item">λ = <b id="m-lam">—</b></span>
        </div>
        <div class="weight-viz" id="weight-viz"></div>
      </div>
      <div id="rec-results"></div>
    </div>

    <!-- CATALOG -->
    <div class="page" id="page-catalog">
      <div class="search-wrap" style="margin-bottom:14px">
        <svg class="search-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input class="search-input" id="search-input" placeholder="Пошук за назвою, ключовими словами, авторами…" autocomplete="off">
        <button id="btn-clear-search">×</button>
      </div>
      <div class="catalog-toolbar">
        <div class="catalog-info" id="catalog-status"></div>
        <div class="toolbar-right">
          <div class="tag-strip">
            <input id="tag-input" type="text" placeholder="тег…" class="field-input" style="width:110px;padding:5px 9px;font-size:11px">
            <button class="btn btn-outline btn-sm" id="btn-find-tag">🔍 Знайти</button>
            <button class="btn btn-danger btn-sm" id="btn-delete-tag">✕ Тег</button>
          </div>
          <div class="pager">
            <button class="btn btn-outline btn-sm btn-icon" id="btn-prev">‹</button>
            <span class="pager-info" id="browse-info"></span>
            <button class="btn btn-outline btn-sm btn-icon" id="btn-next">›</button>
          </div>
        </div>
      </div>
      <div id="tag-result" style="display:none;margin-bottom:14px"></div>
      <div id="search-results" style="display:none"></div>
      <div id="browse-results"></div>
    </div>

    <!-- MY PAPERS -->
    <div class="page" id="page-mypapers">
      <div class="my-header">
        <div class="section-title">Мої статті</div>
        <div class="section-sub" id="mypapers-user-label">Оберіть профіль на сторінці рекомендацій</div>
      </div>
      <div class="tabs">
        <button class="tab-btn active" data-tab="viewed">👁 Прочитані <span id="cnt-viewed">0</span></button>
        <button class="tab-btn" data-tab="liked">♥ Лайкнуті <span id="cnt-liked">0</span></button>
        <button class="tab-btn" data-tab="saved">🔖 Збережені <span id="cnt-saved">0</span></button>
      </div>
      <div id="mypapers-viewed" class="tab-content active"></div>
      <div id="mypapers-liked"  class="tab-content"></div>
      <div id="mypapers-saved"  class="tab-content"></div>
    </div>

    <!-- USERS -->
    <div class="page" id="page-users">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px">
        <div class="section-title">Профілі</div>
        <button class="btn btn-solid btn-md" id="btn-show-add-user">+ Додати профіль</button>
      </div>
      <div id="add-user-form" style="display:none" class="form-card">
        <div class="form-card-title">Новий дослідник</div>
        <div class="form-grid">
          <div class="form-field"><label class="field-label">Ім'я *</label><input id="new-name" type="text" placeholder="Прізвище Ім'я" class="field-input"></div>
          <div class="form-field"><label class="field-label">Установа</label><input id="new-inst" type="text" placeholder="Університет / Інститут" class="field-input"></div>
        </div>
        <div class="form-field" style="margin-bottom:16px">
          <label class="field-label">Наукові інтереси * <span style="color:var(--ink3);font-weight:400">(через кому)</span></label>
          <input id="new-interests" type="text" placeholder="machine learning, NLP, computer vision" class="field-input">
          <div class="interests-preview" id="interests-preview"></div>
        </div>
        <div class="form-actions">
          <button class="btn btn-solid btn-md" id="btn-save-user">Зберегти</button>
          <button class="btn btn-ghost btn-md" id="btn-cancel-user">Скасувати</button>
