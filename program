@app.route("/api/similar/<pid>")
def api_similar(pid):
    results=SYS.cb.similar(pid,SYS.papers,top_k=8)
    return jsonify([{"paper":p.to_dict(),"score":round(s,4)} for p,s,_ in results])

@app.route("/api/search")
def api_search():
    q=request.args.get("q","").lower().split()
    if not q: return jsonify([])
    results=[]
    for p in SYS.papers:
        text=f"{p.title} {p.abstract} {' '.join(p.keywords)}".lower()
        score=sum(text.count(w)+p.title.lower().count(w)*5 for w in q)
        if score>0: results.append((p,score))
    results.sort(key=lambda x:x[1],reverse=True)
    return jsonify([{"paper":p.to_dict(),"relevance":s} for p,s in results[:12]])

@app.route("/api/users/<uid>/history")
def api_user_history(uid):
    user = SYS.users_map.get(uid)
    if not user: return jsonify({"error":"Not found"}), 404
    papers_map = {p.id: p for p in SYS.papers}
    def enrich(pids):
        return [papers_map[pid].to_dict() for pid in reversed(pids) if pid in papers_map]
    return jsonify({
        "user":    user.to_dict(),
        "viewed":  enrich(user.viewed_papers),
        "liked":   enrich(user.liked_papers),
        "saved":   enrich(user.saved_papers),
    })

@app.route("/api/interact",methods=["POST"])
def api_interact():
    d=request.json; uid=d.get("user_id"); pid=d.get("paper_id"); action=d.get("action")
    user=SYS.users_map.get(uid)
    if not user: return jsonify({"error":"User not found"}),404
    # Remove from viewed exclusion if user explicitly likes/saves
    if action == "unlike" and pid in user.liked_papers:
        user.liked_papers.remove(pid)
    elif action == "unsave" and pid in user.saved_papers:
        user.saved_papers.remove(pid)
    else:
        user.add_interaction(pid, action)
    save_users(SYS.users)
    return jsonify({
        "ok": True,
        "viewed": user.viewed_papers,
        "liked":  user.liked_papers,
        "saved":  user.saved_papers,
    })

@app.route("/api/papers/tag/<tag>", methods=["GET"])
def api_papers_by_tag(tag):
    """Повертає всі статті з певним тегом"""
    tag_lower = tag.lower()
    results = [p for p in SYS.papers if tag_lower in [k.lower() for k in p.keywords]]
    return jsonify({"papers": [p.to_dict() for p in results], "total": len(results), "tag": tag})

@app.route("/api/papers/tag/<tag>", methods=["DELETE"])
def api_remove_tag(tag):
    """Видаляє тег з усіх статей"""
    tag_lower = tag.lower()
    count = 0
    for p in SYS.papers:
        before = len(p.keywords)
        p.keywords = [k for k in p.keywords if k.lower() != tag_lower]
        if len(p.keywords) < before:
            count += 1
    # Refit content-based after keyword change
    try: SYS.cb.fit(SYS.papers)
    except Exception as e: logger.warning(f"CB refit: {e}")
    logger.info(f"Removed tag '{tag}' from {count} papers")
    return jsonify({"ok": True, "tag": tag, "papers_affected": count})

@app.route("/api/papers")
def api_papers():
    page=int(request.args.get("page",1)); per=20
    start=(page-1)*per
    return jsonify({"papers":[p.to_dict() for p in SYS.papers[start:start+per]],
                    "total":len(SYS.papers),"page":page,"pages":(len(SYS.papers)+per-1)//per})

