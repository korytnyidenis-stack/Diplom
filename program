class ContentBasedService:
    def __init__(self):
        self.vectorizer=TfidfVectorizer(max_features=5000,stop_words="english",ngram_range=(1,2),min_df=1,sublinear_tf=True)
        self.paper_vectors=None; self.paper_ids=[]; self.is_fitted=False
    def fit(self,papers):
        corpus,self.paper_ids=[],[]
        for p in papers:
            corpus.append(f"{p.title} {p.title} {p.abstract} {' '.join(p.keywords)} {' '.join(p.keywords)} {p.venue}".lower())
            self.paper_ids.append(p.id)
        self.paper_vectors=self.vectorizer.fit_transform(corpus); self.is_fitted=True
        logger.info(f"[CB] Fitted. Vocab: {len(self.vectorizer.vocabulary_)}")
    def _uv(self,user):
        it=" ".join(user.research_interests)*3
        pos=user.liked_papers+user.saved_papers
        if not pos and not user.viewed_papers: return self.vectorizer.transform([it.lower()])
        vecs=[self.vectorizer.transform([it.lower()])]; ws=[2.0]
        for pid in pos:
            if pid in self.paper_ids: vecs.append(self.paper_vectors[self.paper_ids.index(pid)]); ws.append(3.0)
        for pid in user.viewed_papers[:10]:
            if pid in self.paper_ids: vecs.append(self.paper_vectors[self.paper_ids.index(pid)]); ws.append(1.0)
        st=sp_vstack(vecs); wt=st.multiply(np.array(ws).reshape(-1,1))
        return csr_matrix(np.asarray(wt.sum(axis=0)))
    def recommend(self,user,papers,top_k=20,exclude=None):
        pm={p.id:p for p in papers}; ex=set(exclude or [])|set(user.viewed_papers)
        sims=cosine_similarity(self._uv(user),self.paper_vectors).flatten()
        res=[]
        for pid,s in zip(self.paper_ids,sims):
            if pid in ex: continue
            p=pm.get(pid)
            if p:
                ov=set(" ".join(user.research_interests).lower().split())&set(" ".join(p.keywords).lower().split())
                reason=f"Matches: {', '.join(sorted(ov)[:3])}" if ov else f"Related: {', '.join(p.keywords[:2])}"
                res.append((p,float(s),reason))
        res.sort(key=lambda x:x[1],reverse=True); return res[:top_k]
    def similar(self,pid,papers,top_k=8):
        if pid not in self.paper_ids: return []
        pm={p.id:p for p in papers}; idx=self.paper_ids.index(pid)
        sims=cosine_similarity(self.paper_vectors[idx],self.paper_vectors).flatten()
        res=[(pm[p],float(s),"Content similarity") for p,s in zip(self.paper_ids,sims) if p!=pid and p in pm]
        res.sort(key=lambda x:x[1],reverse=True); return res[:top_k]
    @property
    def status(self): return {"service":"ContentBasedService","status":"healthy" if self.is_fitted else "init","model":"TF-IDF + Cosine Similarity","vocab_size":len(self.vectorizer.vocabulary_) if self.is_fitted else 0,"papers_indexed":len(self.paper_ids)}

class CollaborativeFilteringService:
    def __init__(self,n=15):
        self.n=n; self.uf=self.itf=self.sig=None; self.uids=[]; self.pids=[]; self.mat=None; self.fitted=False
    def fit(self,users,papers):
        self.uids=[u.user_id for u in users]; self.pids=[p.id for p in papers]
        pidx={p:i for i,p in enumerate(self.pids)}; uidx={u:i for i,u in enumerate(self.uids)}
        rows,cols,data=[],[],[]
        for u in users:
            ui=uidx[u.user_id]
            for pid in u.viewed_papers:
                if pid in pidx: rows.append(ui);cols.append(pidx[pid]);data.append(1.0)
            for pid in u.liked_papers:
                if pid in pidx: rows.append(ui);cols.append(pidx[pid]);data.append(3.0)
            for pid in u.saved_papers:
                if pid in pidx: rows.append(ui);cols.append(pidx[pid]);data.append(5.0)
        if not data: self._synth(users,papers,pidx,uidx,rows,cols,data)
        self.mat=csr_matrix((data,(rows,cols)),shape=(len(self.uids),len(self.pids)),dtype=np.float32)
        k=min(self.n,min(len(self.uids),len(self.pids))-1)
        U,sig,VT=svds(self.mat.astype(float),k=k); idx=np.argsort(sig)[::-1]
        self.sig=sig[idx]; self.uf=U[:,idx]; self.itf=VT[idx,:]; self.fitted=True
        logger.info(f"[CF] SVD done. Explained var: {self._ev():.1%}")
    def _synth(self,users,papers,pidx,uidx,rows,cols,data):
        rng=random.Random(42); dm={}
        for p in papers:
            for kw in p.keywords: dm.setdefault(kw.lower(),[]).append(p.id)
        for u in users:
            ui=uidx[u.user_id]; rel=[]
            for i in u.research_interests:
                for kw,ps in dm.items():
                    if i.lower() in kw or kw in i.lower(): rel.extend(ps[:15])
            if not rel: rel=[p.id for p in rng.sample(papers,min(10,len(papers)))]
            for pid in rng.sample(rel,min(8,len(rel))):
                if pid in pidx: rows.append(ui);cols.append(pidx[pid]);data.append(1.0)
            for pid in rng.sample(rel,min(4,len(rel))):
                if pid in pidx: rows.append(ui);cols.append(pidx[pid]);data.append(3.0)
    def _ev(self):
        if self.sig is None or self.mat is None: return 0
        t=(self.mat.data**2).sum(); return min((self.sig**2).sum()/(t+1e-10),1.0)
    def recommend(self,uid,papers,top_k=20,exclude=None):
        if not self.fitted or uid not in self.uids: return []
        pm={p.id:p for p in papers}; ex=set(exclude or [])
        ui=self.uids.index(uid); scores=self.uf[ui]@np.diag(self.sig)@self.itf
        res=[(pm[pid],float(s),"Recommended by users with similar interests")
             for pid,s in zip(self.pids,scores) if pid not in ex and pid in pm]
        res.sort(key=lambda x:x[1],reverse=True); return res[:top_k]
    def similar_users(self,uid,top_k=3):
        if not self.fitted or uid not in self.uids: return []
        ui=self.uids.index(uid); sims=cosine_similarity(self.uf[ui].reshape(1,-1),self.uf).flatten()
        res=[(self.uids[i],float(sims[i])) for i in range(len(self.uids)) if self.uids[i]!=uid]
        res.sort(key=lambda x:x[1],reverse=True); return res[:top_k]
    @property
    def status(self): return {"service":"CollaborativeFilteringService","status":"healthy" if self.fitted else "init","model":f"SVD Matrix Factorization (k={self.n})","matrix_shape":f"{len(self.uids)}×{len(self.pids)}" if self.fitted else "N/A","explained_variance":f"{self._ev():.1%}" if self.fitted else "N/A"}

class KnowledgeGraphService:
    def __init__(self,d=0.85,mi=100):
        self.d=d; self.mi=mi; self.cg={}; self.kg={}; self.pg={}; self.pr={}; self.pids=[]; self.fitted=False
    def fit(self,papers):
        self.pids=[p.id for p in papers]; rng=random.Random(123)
        for p in papers:
            for kw in p.keywords: self.kg.setdefault(kw.lower(),set()).add(p.id)
        sp=sorted(papers,key=lambda p:p.year)
        for i,p in enumerate(sp):
            self.cg.setdefault(p.id,set()); self.pg.setdefault(p.id,set())
            cands=[c for c in sp[:i] if set(c.keywords)&set(p.keywords)]
            for c in rng.sample(cands,min(len(cands),rng.randint(2,8))):
                self.cg.setdefault(c.id,set()).add(p.id)
                self.pg[p.id].add(c.id); self.pg.setdefault(c.id,set()).add(p.id)
        self.pr=self._pagerank(); self.fitted=True
        logger.info(f"[KG] Graph built. Nodes:{len(self.pids)} Edges:{sum(len(v) for v in self.pg.values())}")
    def _pagerank(self):
        n=len(self.pids)
        if not n: return {}
        sc={p:1/n for p in self.pids}
        for it in range(self.mi):
            ns={}
            for p in self.pids:
                rs=sum(sc.get(c,0)/max(len(self.pg.get(c,set())),1) for c in self.cg.get(p,set()))
                ns[p]=(1-self.d)/n+self.d*rs
            if sum(abs(ns[p]-sc[p]) for p in self.pids)<1e-6: break
            sc=ns
        mx=max(sc.values()) or 1; return {p:s/mx for p,s in sc.items()}
    def recommend(self,user,papers,top_k=20,exclude=None):
        pm={p.id:p for p in papers}; ex=set(exclude or [])|set(user.viewed_papers); cs={}
        for i in user.research_interests:
            for w in i.lower().split():
                for kw,ps in self.kg.items():
                    if w in kw or kw in w:
                        for p in ps:
                            if p not in ex: cs[p]=cs.get(p,0)+1
        for pid,rel in list(cs.items()):
            for n in self.pg.get(pid,set()):
                if n not in ex and n not in cs: cs[n]=cs.get(n,0)+rel*0.5
        res=[]
        for pid,rel in cs.items():
            p=pm.get(pid)
            if p:
                pr=self.pr.get(pid,0); cite=min(p.citations/500,1)
                res.append((p,rel*0.5+pr*0.3+cite*0.2,f"Citation impact ({p.citations} cit., PageRank:{pr:.3f})"))
        res.sort(key=lambda x:x[1],reverse=True); return res[:top_k]
    @property
    def status(self): return {"service":"KnowledgeGraphService","status":"healthy" if self.fitted else "init","model":f"Knowledge Graph + PageRank (d={self.d})","nodes":len(self.pids),"edges":sum(len(v) for v in self.pg.values()),"keywords":len(self.kg)}

class HybridService:
    def __init__(self,cb,cf,kg):
        self.cb=cb; self.cf=cf; self.kg=kg
        self.weights={"content_based":0.40,"collaborative":0.35,"knowledge_graph":0.25}
    def recommend(self,user,papers,top_k=10,lam=0.3):
        t0=time.time(); ex=set(user.viewed_papers); sm={}
        def collect(res,key):
            if not res: return
            mx=max(s for _,s,_ in res)+1e-9; mn=min(s for _,s,_ in res)
            rng_=mx-mn+1e-9
            icons={"content_based":"📄","collaborative":"👥","knowledge_graph":"🔗"}
            for p,s,r in res:
                e=sm.setdefault(p.id,{"paper":p,"scores":{},"reasons":[]})
                e["scores"][key]=(s-mn)/rng_; e["reasons"].append(f"{icons[key]} {r}")
        try: collect(self.cb.recommend(user,papers,50,list(ex)),"content_based")
        except Exception as e: logger.warning(f"CB:{e}")
        try: collect(self.cf.recommend(user.user_id,papers,50,list(ex)),"collaborative")
        except Exception as e: logger.warning(f"CF:{e}")
        try: collect(self.kg.recommend(user,papers,50,list(ex)),"knowledge_graph")
        except Exception as e: logger.warning(f"KG:{e}")
        for d in sm.values():
            tw=sum(self.weights[m] for m in d["scores"])
            d["final"]=sum(self.weights[m]*s for m,s in d["scores"].items())/(tw+1e-9)
            d["models"]=list(d["scores"].keys())
        ranked=sorted(sm.values(),key=lambda x:x["final"],reverse=True)
        sel=self._mmr(ranked,lam,top_k)
        return {"recommendations":[self._fmt(it,i+1) for i,it in enumerate(sel)],
                "metadata":{"total":len(sm),"cb":sum(1 for d in sm.values() if "content_based" in d["scores"]),
                            "cf":sum(1 for d in sm.values() if "collaborative" in d["scores"]),
                            "kg":sum(1 for d in sm.values() if "knowledge_graph" in d["scores"]),
                            "latency_ms":round((time.time()-t0)*1000,1),"weights":self.weights,"lambda":lam}}
    def _mmr(self,cands,lam,k):
        if not cands: return []
        if lam>=0.99: return cands[:k]
        sel=[cands[0]]; rem=cands[1:]
        while len(sel)<k and rem:
            best=max(rem,key=lambda it: lam*it["final"]-((1-lam)*max(self._ks(it["paper"],s["paper"]) for s in sel)))
            sel.append(best); rem.remove(best)
        return sel
    def _ks(self,p1,p2):
        k1=set(k.lower() for k in p1.keywords); k2=set(k.lower() for k in p2.keywords)
        return len(k1&k2)/len(k1|k2) if k1 and k2 else 0
    def _fmt(self,it,rank):
        return {"rank":rank,"score":round(it["final"],4),"models":it["models"],
                "reasons":list(dict.fromkeys(it["reasons"]))[:3],"paper":it["paper"].to_dict()}
    @property
    def status(self): return {"service":"HybridEnsembleService","status":"healthy","model":"Hybrid Ensemble + MMR","weights":self.weights,"sub":[self.cb.status,self.cf.status,self.kg.status]}

