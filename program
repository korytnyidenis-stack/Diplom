@dataclass
class Author:
    id: str; name: str; affiliation: str; h_index: int = 0

@dataclass
class Paper:
    id: str; title: str; abstract: str; authors: List[Author]
    keywords: List[str]; year: int; venue: str; citations: int
    doi: Optional[str] = None; full_text_available: bool = False
    def to_dict(self):
        return {"id":self.id,"title":self.title,"abstract":self.abstract,
                "authors":[{"id":a.id,"name":a.name,"affiliation":a.affiliation} for a in self.authors],
                "keywords":self.keywords,"year":self.year,"venue":self.venue,
                "citations":self.citations,"doi":self.doi,"open_access":self.full_text_available}

@dataclass
class UserProfile:
    user_id:str; name:str; research_interests:List[str]; institution:str
    viewed_papers:List[str]=field(default_factory=list)
    liked_papers:List[str]=field(default_factory=list)
    saved_papers:List[str]=field(default_factory=list)
    interaction_history:List[Dict]=field(default_factory=list)
    def add_interaction(self, paper_id:str, action:str):
        self.interaction_history.append({"paper_id":paper_id,"action":action,"timestamp":datetime.now().isoformat()})
        if action=="view" and paper_id not in self.viewed_papers: self.viewed_papers.append(paper_id)
        elif action=="like" and paper_id not in self.liked_papers: self.liked_papers.append(paper_id)
        elif action=="save" and paper_id not in self.saved_papers: self.saved_papers.append(paper_id)
    def to_dict(self, full=False):
        d = {"user_id":self.user_id,"name":self.name,"research_interests":self.research_interests,
             "institution":self.institution,"viewed":len(self.viewed_papers),
             "liked":len(self.liked_papers),"saved":len(self.saved_papers)}
        if full:
            d["viewed_papers"]  = self.viewed_papers
            d["liked_papers"]   = self.liked_papers
            d["saved_papers"]   = self.saved_papers
            d["interaction_history"] = self.interaction_history[-50:]
        return d

# ── Persistence: збереження/завантаження профілів ─────────────────
USERS_FILE = "users.json"

def save_users(users):
    data = []
    for u in users:
        data.append({
            "user_id": u.user_id,
            "name": u.name,
            "research_interests": u.research_interests,
            "institution": u.institution,
            "viewed_papers": u.viewed_papers,
            "liked_papers": u.liked_papers,
            "saved_papers": u.saved_papers,
        })
    with open(USERS_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    logger.info(f"Saved {len(data)} users to {USERS_FILE}")

def load_users():
    if not os.path.exists(USERS_FILE):
        logger.info("No users.json found, using defaults")
        return generate_users()
    try:
        with open(USERS_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
        users = []
        for d in data:
            u = UserProfile(
                d["user_id"], d["name"],
                d.get("research_interests", []),
                d.get("institution", ""),
            )
            u.viewed_papers = d.get("viewed_papers", [])
            u.liked_papers  = d.get("liked_papers", [])
            u.saved_papers  = d.get("saved_papers", [])
            users.append(u)
        logger.info(f"Loaded {len(users)} users from {USERS_FILE}")
        return users
    except Exception as e:
        logger.warning(f"Failed to load users.json: {e}. Using defaults.")
        return generate_users()


